# ═══════════════════════════════════════════════════════════════════════════
#  Jinx Harness — configuration
#
#  You normally never edit this file: the one-time web wizard (/setup)
#  writes it for you, and the admin panel can change providers later.
#
#  Manual path:   cp portable/.env.example portable/.env   then fill it in.
#  Real environment variables take precedence over this file.
#
#  Provider guide (فارسی): docs/PROVIDERS.md
# ═══════════════════════════════════════════════════════════════════════════

# ─── Required ───────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Your numeric Telegram id (message @userinfobot to see it)
ADMIN_ID=123456789

# Web admin panel secret — a long random string. Quick generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ─── AI provider (no default exists — you choose) ───────────────────────────
# Any OpenAI-compatible endpoint works. Examples:
#
#   OpenAI:       JINX_BASE_URL=https://api.openai.com/v1        JINX_MODEL=gpt-4o-mini
#   OpenRouter:   JINX_BASE_URL=https://openrouter.ai/api/v1     JINX_MODEL=deepseek/deepseek-chat
#   Groq:         JINX_BASE_URL=https://api.groq.com/openai/v1   JINX_MODEL=llama-3.3-70b-versatile
#   DeepSeek:     JINX_BASE_URL=https://api.deepseek.com/v1      JINX_MODEL=deepseek-chat
#   Ollama:       JINX_BASE_URL=http://127.0.0.1:11434/v1        JINX_MODEL=qwen2.5:7b    JINX_API_KEY=ollama
#   LM Studio:    JINX_BASE_URL=http://127.0.0.1:1234/v1         JINX_MODEL=your-model   JINX_API_KEY=lm-studio
#
# Or leave this empty and add providers from the admin panel (/admin →
# Providers) later — no file editing, no restart.
JINX_BASE_URL=
JINX_API_KEY=
JINX_MODEL=

# ─── Branding (all optional — your agent, your name) ────────────────────────
# How the agent introduces itself in messages, menu and panel
JINX_BRAND_NAME=Jinx Harness
# Display alias for the model persona (shown in /status and self-introduction)
JINX_ALIAS=jinx-harness
# Optional "made by …"
# JINX_MAKER_NAME=
# Optional full custom system prompt (persona)
# JINX_PERSONA=

# ─── General (optional — defaults are fine for most) ────────────────────────
TIMEZONE=Asia/Tehran
DEFAULT_LANG=fa

# ─── Advanced (optional — uncomment to activate) ────────────────────────────
# JINX_PORTABLE_DB=portable/data/jinx.db    # database path (default: this)
# PORTABLE_PORT=8788                        # health/panel port (cPanel PORT is picked up)
# JINX_RUN_DEADLINE_MS=21600000             # hard cap per run: 6 hours
# JINX_CHECKPOINT_MS=1800000                # crash checkpoint: every 30 min
# JINX_SUBREQ_LIMIT=1000000                 # outbound subrequest cap per run
# PORTABLE_MODE=poll                        # long-polling (default; works without a domain)
# JINX_BACKUP_KEEP=7                        # daily auto-backups kept
# PORTABLE_MAX_LIFE_MS=50000                # cron-booted hosts: prevent overlap
# PORTABLE_BASE_PATH=/jinx-harness          # if served under a subpath
# JINX_FORCE_FETCH_SHIM=1                   # hosts with low virtual-memory caps (WASM OOM)

# Backup provider (optional — auto-switches when the primary dies)
# JINX_FALLBACK_URL=
# JINX_FALLBACK_KEY=
# JINX_FALLBACK_MODEL=

# Key rotation (optional — comma separated)
# JINX_API_KEYS=

# ─── Google: Gmail / Drive / Calendar (optional) ────────────────────────────
# Create an OAuth 2.0 app in Google Cloud Console and put it here:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Callback URL registered in Google Cloud Console:
#   https://your-domain.example/oauth/google/callback
# OAUTH_REDIRECT_URI=https://your-domain.example/oauth/google/callback
# GOOGLE_TOKEN_KEY=                         # optional token encryption key
# JINX_APPROVAL_TIMEOUT_MS=480000           # sensitive-action approval window (8 min)
# JINX_DEFAULT_MODE=smart                   # default tool mode: full | ask | smart

# ─── Premium research engines (optional — activate by pasting a key) ────────
# Tavily  → tavily.com            (AI-native search; 1,000 free credits/month)
# JINX_TAVILY_KEY=
# Serper  → serper.dev            (real Google results; 2,500 free queries)
# JINX_SERPER_KEY=
# Brave   → brave.com/search/api  (independent 40-billion-page index)
# JINX_BRAVE_KEY=
# Exa     → exa.ai                (neural/semantic search; $10 free credit monthly)
# JINX_EXA_KEY=
# SearXNG → your own instance URLs (comma separated)
# JINX_SEARXNG_URLS=
